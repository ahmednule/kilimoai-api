# Neo4j connection
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="change-this-password"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# Server
NODE_ENV="development"
PORT=4000
# Base URL used to build links in emails (e.g. the verification link).
APP_URL="http://localhost:4000"

# Email / SMTP (for address verification). If SMTP_HOST is unset, the app logs
# the verification link to the console instead of sending — handy in dev.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"          # "true" for port 465 (implicit TLS)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Kilimo AI <no-reply@kilimo.ai>"

# Featherless LLM (optional) — Swahili/English match explanations.
# If FEATHERLESS_API_KEY is unset, the app falls back to a deterministic,
# graph-grounded template, so explanations still work without it.
FEATHERLESS_API_KEY=""
FEATHERLESS_MODEL="CohereForAI/aya-expanse-8b"
FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
